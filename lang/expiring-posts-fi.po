#. Plugin Name of the plugin
#: expiring-posts.php
msgid "Expiring Posts"
msgstr "Vanhenevat artikkelit"

#. Plugin URI of the plugin
#: expiring-posts.php
msgid "https://github.com/ivankruchkoff/expiring-posts"
msgstr ""

#. Description of the plugin
#: expiring-posts.php
msgid "Automatically move a post to an \"Expired\" status on a date you choose. Works with the block editor and the classic editor."
msgstr "Siirtää artikkelin automaattisesti tilaan ”Vanhentunut” valitsemanasi päivänä. Toimii lohkoeditorissa ja klassisessa editorissa."

#. Author of the plugin
#: expiring-posts.php
msgid "Ivan Kruchkoff"
msgstr ""

#. Author URI of the plugin
#: expiring-posts.php
msgid "https://github.com/ivankruchkoff"
msgstr ""

#: includes/class-exp-expiring-posts.php:143 includes/class-exp-expiring-posts.php:770 includes/class-exp-expiring-posts.php:830 includes/class-exp-expiring-posts.php:1177
msgctxt "post status"
msgid "Expired"
msgstr "Vanhentunut"

#. translators: %s: number of expired posts.
#: includes/class-exp-expiring-posts.php:152
#, php-format
msgid "Expired <span class=\"count\">(%s)</span>"
msgid_plural "Expired <span class=\"count\">(%s)</span>"
msgstr[0] "Vanhentunut <span class=\"count\">(%s)</span>"
msgstr[1] "Vanhentuneet <span class=\"count\">(%s)</span>"

#: includes/class-exp-expiring-posts.php:439
msgid "This post cannot be expired, the expiration date is invalid."
msgstr "Tätä artikkelia ei voi vanhentaa, vanhenemispäivä on virheellinen."

#: includes/class-exp-expiring-posts.php:574
msgid "This is not a valid post."
msgstr "Tämä ei ole kelvollinen artikkeli."

#: includes/class-exp-expiring-posts.php:589
msgid "The post provided is not a valid post."
msgstr "Annettu artikkeli ei ole kelvollinen artikkeli."

#. translators: %s: expiry date.
#: includes/class-exp-expiring-posts.php:766 includes/class-exp-expiring-posts.php:822
#, php-format
msgid "Expires on: %s"
msgstr "Vanhenee: %s"

#. translators: %s: expiry date, or the word "Never".
#: includes/class-exp-expiring-posts.php:768 includes/class-exp-expiring-posts.php:825 includes/class-exp-expiring-posts.php:1186
#, php-format
msgid "Expires: %s"
msgstr "Vanhenee: %s"

#: includes/class-exp-expiring-posts.php:769 includes/class-exp-expiring-posts.php:825 inc/js/block-editor.js:136
msgid "Never"
msgstr "Ei koskaan"

#: includes/class-exp-expiring-posts.php:771
msgid "Save Post"
msgstr "Tallenna artikkeli"

#. translators: 1: month, 2: day, 3: year, 4: hour, 5: minute.
#: includes/class-exp-expiring-posts.php:788 includes/class-exp-expiring-posts.php:899
#, php-format
msgid "%1$s %2$s, %3$s at %4$s:%5$s"
msgstr "%2$s. %1$s %3$s klo %4$s.%5$s"

#. translators: %s: expiry date.
#: includes/class-exp-expiring-posts.php:819
#, php-format
msgid "Expired on: %s"
msgstr "Vanhentunut: %s"

#: includes/class-exp-expiring-posts.php:833
msgid "Edit"
msgstr "Muokkaa"

#: includes/class-exp-expiring-posts.php:833
msgid "Edit expiry date and time"
msgstr "Muokkaa vanhenemispäivää ja -aikaa"

#: includes/class-exp-expiring-posts.php:835
msgid "Expiry date and time"
msgstr "Vanhenemispäivä ja -aika"

#: includes/class-exp-expiring-posts.php:867
msgid "Month"
msgstr "Kuukausi"

#. translators: 1: month number (01, 02, etc.), 2: month abbreviation.
#: includes/class-exp-expiring-posts.php:876
#, php-format
msgid "%1$s-%2$s"
msgstr "%1$s-%2$s"

#: includes/class-exp-expiring-posts.php:891
msgid "Day"
msgstr "Päivä"

#: includes/class-exp-expiring-posts.php:892
msgid "Year"
msgstr "Vuosi"

#: includes/class-exp-expiring-posts.php:893
msgid "Hour"
msgstr "Tunti"

#: includes/class-exp-expiring-posts.php:894
msgid "Minute"
msgstr "Minuutti"

#: includes/class-exp-expiring-posts.php:914
msgid "Never expire"
msgstr "Ei vanhene koskaan"

#: includes/class-exp-expiring-posts.php:917
msgid "OK"
msgstr "OK"

#: includes/class-exp-expiring-posts.php:918
msgid "Cancel"
msgstr "Peruuta"

#: includes/class-exp-expiring-posts.php:1017
msgid "Post expiry settings."
msgstr "Artikkelin vanhenemisasetukset."

#: includes/class-exp-expiring-posts.php:1022
msgid "Whether the post expires on the given date."
msgstr "Vanheneeko artikkeli annettuna päivänä."

#: includes/class-exp-expiring-posts.php:1026
msgid "Expiry date in the site timezone. Dates with a UTC offset are converted."
msgstr "Vanhenemispäivä sivuston aikavyöhykkeellä. UTC-poikkeaman sisältävät päivämäärät muunnetaan."

#: includes/class-exp-expiring-posts.php:1071
msgid "Sorry, you are not allowed to change the expiry of this post."
msgstr "Sinulla ei valitettavasti ole oikeutta muuttaa tämän artikkelin vanhenemista."

#: includes/class-exp-expiring-posts.php:1081
msgid "Invalid expiry date."
msgstr "Virheellinen vanhenemispäivä."

#: includes/class-exp-expiring-posts.php:1092
msgid "An expiry date is required."
msgstr "Vanhenemispäivä on pakollinen."

#: includes/functions.php:28
msgid "Either the post or expiration date provided are not valid."
msgstr "Annettu artikkeli tai vanhenemispäivä on virheellinen."

#: includes/functions.php:61
msgid "The post provided is not valid."
msgstr "Annettu artikkeli on virheellinen."

#: inc/js/block-editor.js:97
msgid "This post has expired and is hidden from visitors. Publish it again to restore it."
msgstr "Tämä artikkeli on vanhentunut ja piilotettu vierailijoilta. Palauta se julkaisemalla se uudelleen."

#: inc/js/block-editor.js:132 inc/js/block-editor.js:154
msgid "Expired"
msgstr "Vanhentunut"

#: inc/js/block-editor.js:141
msgid "This post has expired. Publish it again to make it visible."
msgstr "Tämä artikkeli on vanhentunut. Julkaise se uudelleen, jotta se näkyy."

#: inc/js/block-editor.js:143
msgid "This date has passed. The post will expire shortly after you save."
msgstr "Tämä päivä on jo mennyt. Artikkeli vanhenee pian tallentamisen jälkeen."

#: inc/js/block-editor.js:145
msgid "On this date the post moves to the Expired status and is hidden from visitors."
msgstr "Tänä päivänä artikkeli siirtyy tilaan ”Vanhentunut” ja piilotetaan vierailijoilta."

#: inc/js/block-editor.js:154
msgid "Expires"
msgstr "Vanhenee"

#. translators: %s: current expiry date, or "Never".
#: inc/js/block-editor.js:173
#, php-format
msgid "Change expiry: %s"
msgstr "Muuta vanhenemista: %s"

#: inc/js/block-editor.js:185
msgid "Expiry"
msgstr "Vanheneminen"

#: inc/js/block-editor.js:190
msgid "Close"
msgstr "Sulje"

#: inc/js/block-editor.js:196
msgid "Expire this post"
msgstr "Aseta artikkeli vanhenemaan"

#: inc/js/block-editor.js:223
msgid "Expire now"
msgstr "Vanhenna nyt"
