#, php-format
msgid "Change expiry: %s"
msgstr "Cambiar caducidad: %s"

#: inc/js/block-editor.js:185
msgid "Expiry"
msgstr "Caducidad"

#: inc/js/block-editor.js:190
msgid "Close"
msgstr "Cerrar"

#: inc/js/block-editor.js:196
msgid "Expire this post"
msgstr "Hacer que esta entrada caduque"

#: inc/js/block-editor.js:223
msgid "Expire now"
msgstr "Caducar ahora"
