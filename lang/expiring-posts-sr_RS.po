#: includes/class-exp-expiring-posts.php:893
msgid "Hour"
msgstr "Сат"

#: includes/class-exp-expiring-posts.php:894
msgid "Minute"
msgstr "Минут"

#: includes/class-exp-expiring-posts.php:914
msgid "Never expire"
msgstr "Никад не истиче"

#: includes/class-exp-expiring-posts.php:917
msgid "OK"
msgstr "У реду"

#: includes/class-exp-expiring-posts.php:918
msgid "Cancel"
msgstr "Откажи"

#: includes/class-exp-expiring-posts.php:1017
msgid "Post expiry settings."
msgstr "Подешавања истека чланка."

#: includes/class-exp-expiring-posts.php:1022
msgid "Whether the post expires on the given date."
msgstr "Да ли чланак истиче на наведени датум."

#: includes/class-exp-expiring-posts.php:1026
msgid "Expiry date in the site timezone. Dates with a UTC offset are converted."
msgstr "Датум истека у временској зони веб места. Датуми са померајем од UTC се претварају."

#: includes/class-exp-expiring-posts.php:1071
msgid "Sorry, you are not allowed to change the expiry of this post."
msgstr "Нажалост, немате дозволу да мењате истек овог чланка."

#: includes/class-exp-expiring-posts.php:1081
msgid "Invalid expiry date."
msgstr "Неисправан датум истека."

#: includes/class-exp-expiring-posts.php:1092
msgid "An expiry date is required."
msgstr "Датум истека је обавезан."

#: includes/functions.php:28
msgid "Either the post or expiration date provided are not valid."
msgstr "Наведени чланак или датум истека нису исправни."

#: includes/functions.php:61
msgid "The post provided is not valid."
msgstr "Наведени чланак није исправан."

#: inc/js/block-editor.js:97
msgid "This post has expired and is hidden from visitors. Publish it again to restore it."
msgstr "Овај чланак је истекао и скривен је од посетилаца. Поново га објавите да бисте га вратили."

#: inc/js/block-editor.js:132 inc/js/block-editor.js:154
msgid "Expired"
msgstr "Истекло"

#: inc/js/block-editor.js:141
msgid "This post has expired. Publish it again to make it visible."
msgstr "Овај чланак је истекао. Поново га објавите да би био видљив."

#: inc/js/block-editor.js:143
msgid "This date has passed. The post will expire shortly after you save."
msgstr "Овај датум је прошао. Чланак ће истећи убрзо након чувања."

#: inc/js/block-editor.js:145
msgid "On this date the post moves to the Expired status and is hidden from visitors."
msgstr "На овај датум чланак прелази у стање „Истекло“ и скрива се од посетилаца."

#: inc/js/block-editor.js:154
msgid "Expires"
msgstr "Истиче"

#. translators: %s: current expiry date, or "Never".
#: inc/js/block-editor.js:173
#, php-format
msgid "Change expiry: %s"
msgstr "Промени истек: %s"

#: inc/js/block-editor.js:185
msgid "Expiry"
msgstr "Истек"

#: inc/js/block-editor.js:190
msgid "Close"
msgstr "Затвори"

#: inc/js/block-editor.js:196
msgid "Expire this post"
msgstr "Постави истек чланка"

#: inc/js/block-editor.js:223
msgid "Expire now"
msgstr "Означи као истекло"
