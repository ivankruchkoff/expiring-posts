#: includes/class-exp-expiring-posts.php:439
msgid "This post cannot be expired, the expiration date is invalid."
msgstr "لا يمكن إنهاء صلاحية هذه المقالة، تاريخ انتهاء الصلاحية غير صالح."

#: includes/class-exp-expiring-posts.php:574
msgid "This is not a valid post."
msgstr "هذه ليست مقالة صالحة."

#: includes/class-exp-expiring-posts.php:589
msgid "The post provided is not a valid post."
msgstr "المقالة المقدّمة ليست مقالة صالحة."

