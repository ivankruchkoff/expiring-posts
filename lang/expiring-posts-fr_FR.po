msgstr[1] "Expirés <span class=\"count\">(%s)</span>"

#: includes/class-exp-expiring-posts.php:439
msgid "This post cannot be expired, the expiration date is invalid."
msgstr "Cette publication ne peut pas expirer, la date d’expiration n’est pas valide."

