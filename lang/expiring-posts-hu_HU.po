#. Plugin Name of the plugin
#: expiring-posts.php
msgid "Expiring Posts"
msgstr "Lejáró bejegyzések"

#. Plugin URI of the plugin
#: expiring-posts.php
msgid "https://github.com/ivankruchkoff/expiring-posts"
msgstr ""

#. Description of the plugin
#: expiring-posts.php
msgid "Automatically move a post to an \"Expired\" status on a date you choose. Works with the block editor and the classic editor."
msgstr "A bejegyzést a választott napon automatikusan „Lejárt” állapotba helyezi. A blokkszerkesztővel és a klasszikus szerkesztővel is működik."

#. Author of the plugin
#: expiring-posts.php
msgid "Ivan Kruchkoff"
msgstr ""

#. Author URI of the plugin
#: expiring-posts.php
msgid "https://github.com/ivankruchkoff"
msgstr ""

#: includes/class-exp-expiring-posts.php:143 includes/class-exp-expiring-posts.php:770 includes/class-exp-expiring-posts.php:830 includes/class-exp-expiring-posts.php:1177
msgctxt "post status"
msgid "Expired"
msgstr "Lejárt"

#. translators: %s: number of expired posts.
#: includes/class-exp-expiring-posts.php:152
#, php-format
msgid "Expired <span class=\"count\">(%s)</span>"
msgid_plural "Expired <span class=\"count\">(%s)</span>"
msgstr[0] "Lejárt <span class=\"count\">(%s)</span>"
msgstr[1] "Lejárt <span class=\"count\">(%s)</span>"

#: includes/class-exp-expiring-posts.php:439
msgid "This post cannot be expired, the expiration date is invalid."
msgstr "Ez a bejegyzés nem járhat le, a lejárati dátum érvénytelen."

#: includes/class-exp-expiring-posts.php:574
msgid "This is not a valid post."
msgstr "Ez nem érvényes bejegyzés."

#: includes/class-exp-expiring-posts.php:589
msgid "The post provided is not a valid post."
msgstr "A megadott bejegyzés nem érvényes bejegyzés."

#. translators: %s: expiry date.
#: includes/class-exp-expiring-posts.php:766 includes/class-exp-expiring-posts.php:822
#, php-format
msgid "Expires on: %s"
msgstr "Lejár ekkor: %s"

#. translators: %s: expiry date, or the word "Never".
#: includes/class-exp-expiring-posts.php:768 includes/class-exp-expiring-posts.php:825 includes/class-exp-expiring-posts.php:1186
#, php-format
msgid "Expires: %s"
msgstr "Lejárat: %s"

#: includes/class-exp-expiring-posts.php:769 includes/class-exp-expiring-posts.php:825 inc/js/block-editor.js:136
msgid "Never"
msgstr "Soha"

#: includes/class-exp-expiring-posts.php:771
msgid "Save Post"
msgstr "Bejegyzés mentése"

#. translators: 1: month, 2: day, 3: year, 4: hour, 5: minute.
