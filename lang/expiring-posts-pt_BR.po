#. Plugin Name of the plugin
#: expiring-posts.php
msgid "Expiring Posts"
msgstr "Posts com expiração"

#. Plugin URI of the plugin
#: expiring-posts.php
msgid "https://github.com/ivankruchkoff/expiring-posts"
msgstr ""

#. Description of the plugin
#: expiring-posts.php
msgid "Automatically move a post to an \"Expired\" status on a date you choose. Works with the block editor and the classic editor."
msgstr "Move automaticamente um post para o status \"Expirado\" na data que você escolher. Funciona com o editor de blocos e com o editor clássico."

#. Author of the plugin
#: expiring-posts.php
msgid "Ivan Kruchkoff"
msgstr ""

#. Author URI of the plugin
#: expiring-posts.php
msgid "https://github.com/ivankruchkoff"
msgstr ""

